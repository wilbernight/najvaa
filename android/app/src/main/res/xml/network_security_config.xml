<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- TLS only and system CAs only: a proxy certificate installed on the
         device by a user or an MDM cannot sit between the app and the relay. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
