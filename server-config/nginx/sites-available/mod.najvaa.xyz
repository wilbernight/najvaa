# Najva admin panel. Only reachable through Cloudflare, and Cloudflare Access
# (one-time PIN to the admin email) sits in front of it.

# The real-IP module has already replaced $remote_addr with the visitor's
# address, so "is this connection from Cloudflare?" uses the original peer.
geo $realip_remote_addr $najva_panel_from_cf {
    default 0;
    173.245.48.0/20 1;  103.21.244.0/22 1;  103.22.200.0/22 1;  103.31.4.0/22 1;
    141.101.64.0/18 1;  108.162.192.0/18 1; 190.93.240.0/20 1;  188.114.96.0/20 1;
    197.234.240.0/22 1; 198.41.128.0/17 1;  162.158.0.0/15 1;   104.16.0.0/13 1;
    104.24.0.0/14 1;    172.64.0.0/13 1;
    2400:cb00::/32 1;   2606:4700::/32 1;   2803:f800::/32 1;   2405:b500::/32 1;
    2405:8100::/32 1;   2a06:98c0::/29 1;
}

server {
    listen 80;
    listen [::]:80;
    server_name mod.najvaa.xyz;
    access_log off;
    return 301 https://mod.najvaa.xyz$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    include snippets/najvaa-origin.conf;
    server_name mod.najvaa.xyz;

    if ($najva_panel_from_cf = 0) { return 444; }
    # Cloudflare Access adds this to every request it lets through.
    if ($http_cf_access_jwt_assertion = "") { return 403; }

    root /var/www/mod.najvaa.xyz/public;
    index index.php;

    access_log off;
    error_log  /var/log/nginx/mod.najvaa.xyz-error.log error;
    server_tokens off;
    client_max_body_size 2M;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /index.php {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/najva-panel.sock;
        fastcgi_param HTTPS on;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ \.php$ { return 404; }
    location ~ /\.(?!well-known) { deny all; }
}
